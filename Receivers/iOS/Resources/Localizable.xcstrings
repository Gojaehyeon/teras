{
  "sourceLanguage": "en",
  "strings": {
    "idle.title.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac를 기다리는 중"
          }
        }
      }
    },
    "idle.title.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중…"
          }
        }
      }
    },
    "idle.title.pairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링"
          }
        }
      }
    },
    "idle.title.connected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨"
          }
        }
      }
    },
    "idle.usbHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in a USB cable and open Tandem on your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 케이블을 연결하고 Mac에서 Tandem을 여세요."
          }
        }
      }
    },
    "idle.wifiOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: visible as “%@”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: “%@”(으)로 표시됨"
          }
        }
      }
    },
    "idle.wifiStarting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting Wi-Fi discovery…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 검색을 시작하는 중…"
          }
        }
      }
    },
    "idle.wifiFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi discovery unavailable. USB still works."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 검색을 사용할 수 없습니다. USB는 계속 사용할 수 있어요."
          }
        }
      }
    },
    "idle.port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening on port %ld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 %ld에서 대기 중"
          }
