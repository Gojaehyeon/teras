    "pairing.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code on your Mac to finish pairing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링을 마치려면 Mac에 이 코드를 입력하세요."
          }
        }
      }
    },
    "pairing.attemptsLeft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld attempts left"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld회 남음"
          }
        }
      }
    },
    "pairing.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong code. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 틀렸습니다. 다시 시도하세요."
          }
        }
      }
    },
    "pairing.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. A new code will be shown."
