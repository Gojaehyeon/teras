      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing code"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드"
          }
        }
